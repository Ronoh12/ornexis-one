  @@unique([organizationId, idempotencyKey], map: "sla_events_org_idempotency_key")
  @@index([organizationId])
  @@index([organizationId, slaInstanceId])
  @@index([organizationId, eventType])
  @@index([organizationId, occurredAt])
  @@map("sla_events")
}

