generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OrganizationUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum ContactType {
  MEMBER
  CUSTOMER
  EMPLOYEE
  SUPPLIER
  VOLUNTEER
  DONOR
  PARTNER
  OTHER
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

enum StorageProvider {
  LOCAL
  S3
  AZURE_BLOB
}

model Organization {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  slug               String             @unique
  organizationType   String             @map("organization_type")
  registrationNumber String?            @map("registration_number")
  email              String?
  phone              String?
  website            String?
  country            String
  currency           String
  timezone           String
  status             OrganizationStatus @default(TRIAL)
  plan               String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  roles              Role[]
  organizationUsers  OrganizationUser[]
  contacts           Contact[]
  auditLogs          AuditLog[]
  settings           OrganizationSetting?
  branding           OrganizationBranding?
  branches           Branch[]
  departments        Department[]
  documents          Document[]
  workItems          WorkItem[]
  workItemComments   WorkItemComment[]
  workItemActivities WorkItemActivity[]
  entityAttachments  EntityAttachment[]
  requestTypes       RequestType[]
  requests           Request[]
  requestComments    RequestComment[]
  requestActivities  RequestActivity[]

  workflowDefinitions     WorkflowDefinition[]
  workflowStates          WorkflowState[]
  workflowTransitions     WorkflowTransition[]
  workflowInstances       WorkflowInstance[]
  workflowHistory         WorkflowHistory[]
  approvalSteps           ApprovalStep[]
  approvalDecisions       ApprovalDecision[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  slaPolicies                SlaPolicy[]
  slaTargets                 SlaTarget[]
  slaInstances               SlaInstance[]
  slaEvents                  SlaEvent[]
  attentionItems             AttentionItem[]
  healthIndicatorDefinitions HealthIndicatorDefinition[]
  healthSnapshots            HealthSnapshot[]
  healthContributions        HealthContribution[]

  @@index([organizationType])
  @@index([status])
  @@map("organizations")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  email           String     @unique
  phone           String?
  passwordHash    String?    @map("password_hash")
  status          UserStatus @default(INVITED)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  organizationUsers OrganizationUser[] @relation("OrganizationUserMembership")

  invitedUsers OrganizationUser[] @relation("OrganizationUserInvitedBy")

  auditLogs           AuditLog[]
  refreshSessions     RefreshSession[]
  invitationTokens    InvitationToken[]
  passwordResetTokens PasswordResetToken[]
  uploadedDocuments   Document[]

  @@index([phone])
  @@index([status])
  @@map("users")
}

model Role {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  description    String?
  isSystemRole   Boolean      @default(false) @map("is_system_role")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  rolePermissions   RolePermission[]
  organizationUsers OrganizationUser[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  module      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model OrganizationUser {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  roleId         String                 @map("role_id") @db.Uuid
  branchId       String?                @map("branch_id") @db.Uuid
  departmentId   String?                @map("department_id") @db.Uuid
  status         OrganizationUserStatus @default(INVITED)
  joinedAt       DateTime?              @map("joined_at")
  invitedBy      String?                @map("invited_by") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  user User @relation("OrganizationUserMembership", fields: [userId], references: [id], onDelete: Restrict)

  role       Role        @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch     Branch?     @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  department Department? @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)

  inviter User? @relation("OrganizationUserInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  invitationTokens InvitationToken[]

  createdWorkItems   WorkItem[] @relation("WorkItemCreatedBy")
  ownedWorkItems     WorkItem[] @relation("WorkItemOwner")
  assignedWorkItems  WorkItem[] @relation("WorkItemAssignee")
  completedWorkItems WorkItem[] @relation("WorkItemCompletedBy")

  workItemComments   WorkItemComment[]  @relation("WorkItemCommentAuthor")
  workItemActivities WorkItemActivity[] @relation("WorkItemActivityActor")

  createdEntityAttachments    EntityAttachment[] @relation("EntityAttachmentAttachedBy")
  requestTypesDefaultAssignee RequestType[]      @relation("RequestTypeDefaultAssignee")
  requestsRequested           Request[]          @relation("RequestRequester")
  requestsAssigned            Request[]          @relation("RequestAssignedTo")
  requestCommentsAuthored     RequestComment[]   @relation("RequestCommentAuthor")
  requestActivitiesActed      RequestActivity[]  @relation("RequestActivityActor")

  startedWorkflowInstances   WorkflowInstance[] @relation("WorkflowInstanceStartedBy")
  completedWorkflowInstances WorkflowInstance[] @relation("WorkflowInstanceCompletedBy")
  workflowHistoryActions     WorkflowHistory[]  @relation("WorkflowHistoryActor")

  approvalDecisions         ApprovalDecision[]       @relation("ApprovalDecisionApprover")
  notifications             Notification[]
  notificationPreferences   NotificationPreference[]
  responsibleAttentionItems AttentionItem[]          @relation("AttentionItemResponsible")

  @@unique([organizationId, userId])
  @@unique([id, userId])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([roleId])
  @@index([branchId])
  @@index([departmentId])
  @@index([organizationId, branchId])
  @@index([organizationId, departmentId])
  @@index([status])
  @@map("organization_users")
}

model Contact {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  branchId         String?       @map("branch_id") @db.Uuid
  departmentId     String?       @map("department_id") @db.Uuid
  contactType      ContactType   @map("contact_type")
  firstName        String?       @map("first_name")
  lastName         String?       @map("last_name")
  organizationName String?       @map("organization_name")
  email            String?
  phone            String?
  secondaryPhone   String?       @map("secondary_phone")
  nationalId       String?       @map("national_id")
  dateOfBirth      DateTime?     @map("date_of_birth") @db.Date
  address          String?
  city             String?
  countyState      String?       @map("county_state")
  country          String?
  status           ContactStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch           Branch?       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  department       Department?   @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)

  workItems WorkItem[]
  requests  Request[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([branchId])
  @@index([departmentId])
  @@index([organizationId, branchId])
  @@index([organizationId, departmentId])
  @@index([organizationId, contactType])
  @@index([organizationId, status])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@map("contacts")
}

model AuditLog {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  userId         String? @map("user_id") @db.Uuid

  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")

  oldValues Json? @map("old_values")
  newValues Json? @map("new_values")

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model InvitationToken {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  organizationUserId String    @map("organization_user_id") @db.Uuid
  tokenHash          String    @unique @map("token_hash")
  expiresAt          DateTime  @map("expires_at")
  consumedAt         DateTime? @map("consumed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationUser OrganizationUser @relation(fields: [organizationUserId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId])
  @@index([organizationUserId])
  @@index([expiresAt])
  @@map("invitation_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model OrganizationSetting {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @unique @map("organization_id") @db.Uuid
  locale          String   @default("en")
  dateFormat      String   @default("YYYY-MM-DD") @map("date_format")
  timeFormat      String   @default("24h") @map("time_format")
  weekStartsOn    Int      @default(1) @map("week_starts_on")
  defaultLanguage String   @default("en") @map("default_language")
  defaultCountry  String?  @map("default_country")
  defaultCurrency String?  @map("default_currency")
  defaultTimezone String?  @map("default_timezone")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model OrganizationBranding {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  displayName    String?  @map("display_name")
  shortName      String?  @map("short_name")
  logoUrl        String?  @map("logo_url")
  faviconUrl     String?  @map("favicon_url")
  primaryColor   String?  @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  accentColor    String?  @map("accent_color")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_branding")
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  code           String?
  description    String?
  email          String?
  phone          String?
  address        String?
  city           String?
  countyState    String?  @map("county_state")
  country        String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  departments       Department[]
  organizationUsers OrganizationUser[]
  contacts          Contact[]
  documents         Document[]
  workItems         WorkItem[]
  requests          Request[]
  attentionItems    AttentionItem[]
  healthSnapshots   HealthSnapshot[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("branches")
}

model Department {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  name           String
  code           String?
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch              Branch?            @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organizationUsers   OrganizationUser[]
  contacts            Contact[]
  documents           Document[]
  workItems           WorkItem[]
  requestTypesDefault RequestType[]      @relation("RequestTypeDefaultDepartment")
  requests            Request[]
  attentionItems      AttentionItem[]
  healthSnapshots     HealthSnapshot[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([branchId])
  @@index([organizationId, isActive])
  @@map("departments")
}

model Document {
  id               String  @id @default(uuid()) @db.Uuid
  organizationId   String  @map("organization_id") @db.Uuid
  branchId         String? @map("branch_id") @db.Uuid
  departmentId     String? @map("department_id") @db.Uuid
  uploadedByUserId String  @map("uploaded_by_user_id") @db.Uuid

  title       String
  description String?

  originalFileName String @map("original_file_name")
  storedFileName   String @map("stored_file_name")

  storageProvider StorageProvider @default(LOCAL) @map("storage_provider")
  storageKey      String          @map("storage_key")

  mimeType       String @map("mime_type")
  fileExtension  String @map("file_extension")
  sizeBytes      BigInt @map("size_bytes")
  checksumSha256 String @map("checksum_sha256")

  status DocumentStatus @default(ACTIVE)

  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch            Branch?            @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  department        Department?        @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  uploadedBy        User               @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  entityAttachments EntityAttachment[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, branchId])
  @@index([organizationId, departmentId])
  @@index([organizationId, mimeType])
  @@index([uploadedByUserId])
  @@index([checksumSha256])
  @@map("documents")
}

// =========================================================
// Sprint 011 — Work Management, Collaboration & Accountability
// =========================================================

enum WorkItemStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum WorkItemPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

enum WorkItemActivityType {
  CREATED
  UPDATED
  OWNER_CHANGED
  ASSIGNEE_CHANGED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  STATUS_CHANGED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  COMPLETED
  CANCELLED
}

enum EntityAttachmentType {
  WORK_ITEM
  CONTACT
  REQUEST
}

model WorkItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  branchId     String? @map("branch_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  contactId    String? @map("contact_id") @db.Uuid

  createdByOrganizationUserId String  @map("created_by_organization_user_id") @db.Uuid
  ownerOrganizationUserId     String? @map("owner_organization_user_id") @db.Uuid
  assigneeOrganizationUserId  String? @map("assignee_organization_user_id") @db.Uuid

  title       String
  description String?

  priority WorkItemPriority @default(NORMAL)
  status   WorkItemStatus   @default(OPEN)

  dueAt       DateTime? @map("due_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  completedByOrganizationUserId String? @map("completed_by_organization_user_id") @db.Uuid

  cancelledAt DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branch Branch? @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  department Department? @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)

  contact Contact? @relation(fields: [contactId, organizationId], references: [id, organizationId], onDelete: Restrict)

  createdBy OrganizationUser @relation("WorkItemCreatedBy", fields: [createdByOrganizationUserId, organizationId], references: [id, organizationId], onDelete: Restrict)

  owner OrganizationUser? @relation("WorkItemOwner", fields: [ownerOrganizationUserId, organizationId], references: [id, organizationId], onDelete: Restrict)

  assignee OrganizationUser? @relation("WorkItemAssignee", fields: [assigneeOrganizationUserId, organizationId], references: [id, organizationId], onDelete: Restrict)

  completedBy OrganizationUser? @relation("WorkItemCompletedBy", fields: [completedByOrganizationUserId, organizationId], references: [id, organizationId], onDelete: Restrict)

  comments   WorkItemComment[]
  activities WorkItemActivity[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, ownerOrganizationUserId])
  @@index([organizationId, assigneeOrganizationUserId])
  @@index([organizationId, branchId])
  @@index([organizationId, departmentId])
  @@index([organizationId, contactId])
  @@index([organizationId, dueAt])
  @@index([organizationId, createdAt])
  @@map("work_items")
}

model WorkItemComment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  workItemId String @map("work_item_id") @db.Uuid

  authorOrganizationUserId String @map("author_organization_user_id") @db.Uuid

  body String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  workItem WorkItem @relation(fields: [workItemId, organizationId], references: [id, organizationId], onDelete: Cascade)

  author OrganizationUser @relation("WorkItemCommentAuthor", fields: [authorOrganizationUserId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([workItemId])
  @@index([authorOrganizationUserId])
  @@index([createdAt])
  @@index([organizationId, workItemId])
  @@map("work_item_comments")
}

model WorkItemActivity {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  workItemId String @map("work_item_id") @db.Uuid

  actorOrganizationUserId String? @map("actor_organization_user_id") @db.Uuid

  activityType WorkItemActivityType @map("activity_type")

  oldValues Json? @map("old_values")
  newValues Json? @map("new_values")
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  workItem WorkItem @relation(fields: [workItemId, organizationId], references: [id, organizationId], onDelete: Cascade)

  actor OrganizationUser? @relation("WorkItemActivityActor", fields: [actorOrganizationUserId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([workItemId])
  @@index([actorOrganizationUserId])
  @@index([activityType])
  @@index([createdAt])
  @@index([organizationId, workItemId])
  @@map("work_item_activities")
}

model EntityAttachment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  documentId String @map("document_id") @db.Uuid

  entityType EntityAttachmentType @map("entity_type")
  entityId   String               @map("entity_id") @db.Uuid

  attachedByOrganizationUserId String @map("attached_by_organization_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  document Document @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Restrict)

  attachedBy OrganizationUser @relation("EntityAttachmentAttachedBy", fields: [attachedByOrganizationUserId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, documentId, entityType, entityId])
  @@index([organizationId])
  @@index([documentId])
  @@index([entityType, entityId])
  @@index([organizationId, entityType, entityId])
  @@map("entity_attachments")
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  IN_FULFILMENT
  COMPLETED
  CANCELLED
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

enum RequestActivityType {
  CREATED
  UPDATED
  SUBMITTED
  ASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  COMPLETED
  CANCELLED
}

model RequestType {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name        String
  code        String
  description String?

  formSchema Json? @map("form_schema")

  defaultPriority RequestPriority @default(NORMAL) @map("default_priority")

  defaultAssigneeOrganizationUserId String? @map("default_assignee_organization_user_id") @db.Uuid
  defaultDepartmentId               String? @map("default_department_id") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

