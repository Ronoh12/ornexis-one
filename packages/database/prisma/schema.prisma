model SlaInstance {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  slaPolicyId String @map("sla_policy_id") @db.Uuid
  slaTargetId String @map("sla_target_id") @db.Uuid

